# NeoSecra Update Server — Caddyfile (Public / Let's Encrypt)
# update.neosecra.com + license.neosecra.com with automatic TLS via Let's Encrypt.
# No tls directive = Caddy auto-provisions certificates via HTTP-01 (port 80).
#
# Usage: CADDY_MODE=public docker compose up -d
# Requires:
#   - Public DNS A records for both domains pointing to this server's public IP
#   - Port 80 + 443 inbound in firewall (LE HTTP-01 challenge uses port 80)

update.neosecra.com {
    root * /srv/update
    encode zstd gzip

    # Channel metadata: must always be fresh — client polls for new versions
    @channels {
        path /channels/*
    }
    header @channels Cache-Control "no-cache"

    # Release artifacts: immutable once published, cache aggressively
    @releases {
        path /releases/*
    }
    header @releases Cache-Control "public, max-age=31536000, immutable"

    file_server
}

# License Server
license.neosecra.com {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Backend API + health
    handle /api/* {
        reverse_proxy license-backend-1:8000
    }
    handle /health {
        reverse_proxy license-backend-1:8000
    }

    # SPA frontend
    handle {
        reverse_proxy license-frontend-1:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

http://license.neosecra.com {
    redir https://license.neosecra.com{uri} permanent
}
