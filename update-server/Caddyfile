# NeoSecra Update Server — Caddyfile
# update.neosecra.com + license.neosecra.com TLS with persistent custom CA
# Leaf certs signed by NeoSecra Root CA (ECDSA P-384, 10 years).
# Private keys: /opt/neosecra/secrets/ (600, never committed).

update.neosecra.com {
    tls /etc/caddy/certs/update-neosecra-com.crt /etc/caddy/certs/update-neosecra-com.key
    root * /srv/update
    encode zstd gzip

    # Channel metadata: must always be fresh — client polls for new versions
    @channels {
        path /channels/*
    }
    header @channels Cache-Control "no-cache"

    # Release artifacts: immutable once published, cache aggressively
    @releases {
        path /releases/*
    }
    header @releases Cache-Control "public, max-age=31536000, immutable"

    file_server
}

# License Server
license.neosecra.com {
    tls /etc/caddy/certs/license-neosecra-com.crt /etc/caddy/certs/license-neosecra-com.key

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Backend API + health
    handle /api/* {
        reverse_proxy license-backend-1:8000
    }
    handle /health {
        reverse_proxy license-backend-1:8000
    }

    # SPA frontend
    handle {
        reverse_proxy license-frontend-1:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

http://license.neosecra.com {
    redir https://license.neosecra.com{uri} permanent
}
