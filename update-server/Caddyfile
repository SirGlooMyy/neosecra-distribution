update.neosecra.com:9445, update.neosecra.com {
    tls /etc/caddy/certs/update-neosecra-com.crt /etc/caddy/certs/update-neosecra-com.key
    root * /srv/update
    encode zstd gzip

    @channels {
        path /channels/*
    }
    header @channels Cache-Control "no-cache"

    @releases {
        path /releases/*
    }
    header @releases Cache-Control "public, max-age=31536000, immutable"

    file_server
}

license.neosecra.com:9446, license.neosecra.com {
    tls /etc/caddy/certs/license-neosecra-com.crt /etc/caddy/certs/license-neosecra-com.key

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle /api/* {
        reverse_proxy lisans-backend-1:8000
    }
    handle /health {
        reverse_proxy lisans-backend-1:8000
    }

    handle {
        reverse_proxy lisans-frontend-1:5173 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

registry.neosecra.com:9447, registry.neosecra.com {
    tls /etc/caddy/certs/registry.neosecra.com.crt /etc/caddy/certs/registry.neosecra.com.key
    reverse_proxy registry:5000
}

# Assessment lab/public entrypoint. Keep both spellings during the DNS
# transition; the wildcard Cloudflare Origin certificate covers each host.
assessment.neosecra.com, assesment.neosecra.com {
    tls /etc/caddy/certs/neosecra.com.crt /etc/caddy/certs/neosecra.com.key

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle /api/* {
        reverse_proxy 10.34.99.10:23800 {
            header_up X-Forwarded-Proto https
        }
    }
    handle /health {
        reverse_proxy 10.34.99.10:23800 {
            header_up X-Forwarded-Proto https
        }
    }
    handle {
        reverse_proxy 10.34.99.10:23300 {
            header_up X-Forwarded-Proto https
        }
    }
}

:443, :7443 {
    tls /etc/caddy/certs/neosecra.com.crt /etc/caddy/certs/neosecra.com.key
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Cache-Control "no-cache, no-store, must-revalidate"
        Pragma "no-cache"
        Expires "0"
        -Server
    }

    redir /index.html / permanent
    redir /index / permanent

    route {
        handle /api/demo-request* {
            reverse_proxy demo-mailer:8000
        }

        handle {
            root * /srv/web
            try_files {path} {path}.html {path}/ /index.html
            file_server
        }
    }
}

:80 {
    redir https://{host}{uri} permanent
}
