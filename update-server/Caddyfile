# NeoSecra Update Server — Caddyfile
update.neosecra.com {
    tls /etc/caddy/certs/update-neosecra-com.crt /etc/caddy/certs/update-neosecra-com.key
    root * /srv/update
    encode zstd gzip

    @channels {
        path /channels/*
    }
    header @channels Cache-Control "no-cache"

    @releases {
        path /releases/*
    }
    header @releases Cache-Control "public, max-age=31536000, immutable"

    file_server
}

# License Server
license.neosecra.com {
    tls /etc/caddy/certs/license-neosecra-com.crt /etc/caddy/certs/license-neosecra-com.key

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    handle /api/* {
        reverse_proxy license-backend-1:8000
    }
    handle /health {
        reverse_proxy license-backend-1:8000
    }

    handle {
        reverse_proxy license-frontend-1:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}

http://license.neosecra.com {
    redir https://license.neosecra.com{uri} permanent
}

# NeoSecra Pish Automated Let's Encrypt SSL Block (Port 8443)
pish.neosecra.com:8443, youtubeizle.club:8443 {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    encode gzip zstd

    handle /api/* {
        reverse_proxy neosecra-pish-backend-1:8000
    }
    handle /health {
        reverse_proxy neosecra-pish-backend-1:8000
    }
    handle {
        reverse_proxy neosecra-pish-frontend-1:8080
    }
}

# NeoSecra Pish Direct IP Fallback on Port 8443 (Self-Signed / IP SAN)
:8443 {
    tls /etc/caddy/certs/ip_fallback.crt /etc/caddy/certs/ip_fallback.key
    encode gzip zstd

    handle /api/* {
        reverse_proxy neosecra-pish-backend-1:8000
    }
    handle /health {
        reverse_proxy neosecra-pish-backend-1:8000
    }
    handle {
        reverse_proxy neosecra-pish-frontend-1:8080
    }
}

# NeoSecra Pish Portal (HTTP Port 24300)
:24300 {
    encode gzip zstd

    handle /api/* {
        reverse_proxy neosecra-pish-backend-1:8000
    }
    handle /health {
        reverse_proxy neosecra-pish-backend-1:8000
    }
    handle {
        reverse_proxy neosecra-pish-frontend-1:8080
    }
}

# Assessment Platform — public HTTPS (Let's Encrypt certbot, DNS: assesment.neosecra.com -> 78.186.17.177)
assesment.neosecra.com:9443 {
    tls /etc/caddy/certs/letsencrypt/live/assesment.neosecra.com/fullchain.pem /etc/caddy/certs/letsencrypt/live/assesment.neosecra.com/privkey.pem
    reverse_proxy host.docker.internal:23300 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}
