# NeoSecra Update Server — Caddyfile
# Cloudflare tunnel hazirligi (kullanici onayli FINAL port plani):
#   update.neosecra.com    -> :9445
#   license.neosecra.com   -> :9446
#   registry.neosecra.com  -> :9447
#   assesment.neosecra.com -> :9443 (AYRI assessment stack — bu dosyada yok)
# TLS internal CA aynen duruyor. Host port mapping 944X (docker-compose, 0.0.0.0).
# Geri donus plani: compose'daki 80/443 satirlarini actiktan sonra asagidaki
# vhost portlarini kaldirmak yeterli.

update.neosecra.com:9445 {
    tls /etc/caddy/certs/update-neosecra-com.crt /etc/caddy/certs/update-neosecra-com.key
    root * /srv/update
    encode zstd gzip

    # Channel metadata: must always be fresh — client polls for new versions
    @channels {
        path /channels/*
    }
    header @channels Cache-Control "no-cache"

    # Release artifacts: immutable once published, cache aggressively
    @releases {
        path /releases/*
    }
    header @releases Cache-Control "public, max-age=31536000, immutable"

    file_server
}

# License Server
license.neosecra.com:9446 {
    tls /etc/caddy/certs/license-neosecra-com.crt /etc/caddy/certs/license-neosecra-com.key

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Backend API + health
    handle /api/* {
        reverse_proxy license-backend-1:8000
    }
    handle /health {
        reverse_proxy license-backend-1:8000
    }

    # SPA frontend
    handle {
        reverse_proxy license-frontend-1:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}


# Docker Registry — kendi image sunucumuz (ghcr yerine)
registry.neosecra.com:9447 {
    tls /etc/caddy/certs/registry.neosecra.com.crt /etc/caddy/certs/registry.neosecra.com.key
    reverse_proxy registry:5000
}

# http redir bloklari kapali — port 80 mapping yorum (geri donus plani). Cloudflare
# tunnel ic portlara yonelir; eski public 80->443 redir gerekmiyor.
# http://registry.neosecra.com {
#     redir https://registry.neosecra.com{uri} permanent
# }
