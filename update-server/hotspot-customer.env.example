# Customer input for bootstrap-hotspot.sh --config FILE.
# Copy to a private file on the target host (chmod 600); never commit secrets.
# Required: HTTPS origin configured on your reverse proxy.
PORTAL_PUBLIC_BASE_URL=
PORTAL_APP_BASE_URL=https://hotspot.customer.example
CORS_ORIGINS=https://hotspot.customer.example

# Choose your contracted provider and fill its fields.
# Supported by installer: netgsm, twilio, vatansms, iletimerkezi, muttl,
# relateddigital, http. console is not a production SMS gateway.
SMS_PROVIDER=
SMS_SENDER=
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VATANSMS_API_ID=
VATANSMS_API_KEY=
ILETIMERKEZI_API_KEY=
ILETIMERKEZI_API_HASH=
MUTTL_API_KEY=
MUTTL_API_URL=
RELATEDDIGITAL_API_KEY=
RELATEDDIGITAL_API_URL=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# Technical timestamp prerequisite for customer evidence acceptance.
# The CA bundle must also be provisioned at this path inside API/worker.
TUBITAK_TSA_REQUIRED=true
TUBITAK_TSA_URL=
TUBITAK_TSA_CA_BUNDLE=/app/ca/customer-tsa-chain.pem
TUBITAK_TSA_USERNAME=
TUBITAK_TSA_PASSWORD=

# Bootstrap sets production safety flags and generates unique DB, encryption,
# RADIUS and syslog credentials. Reinstall preserves existing credentials.
ARCHIVE_ENCRYPTION_ENABLED=true
ARCHIVE_MINIO_OBJECT_LOCK_REQUIRED=true
CLICKHOUSE_ENABLED=true
UPGRADE_CHANNEL_VERIFY_SSL=true
