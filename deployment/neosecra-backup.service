[Unit]
Description=NeoSecra Assessment — daily backup
Documentation=https://docs.neosecra.com
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/neosecra/assessment/current/scripts/backup.sh
User=root
Group=root
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
