[Unit]
Description=NeoSecra Update Agent — executes triggered upgrade/rollback
Documentation=https://github.com/SirGlooMyy/neosecra-distribution
BindsTo=neosecra-update-agent.path
After=neosecra-update-agent.path network-online.target
Requires=network-online.target

[Service]
Type=oneshot
# current -> releases/<ver> symlink (bootstrap/upgrade switch it); units keep
# working across upgrades because they follow the symlink.
EnvironmentFile=-@ENV_FILE@
Environment=HOME=/root
Environment=NEOSECRA_INSTALL_ROOT=@INSTALL_ROOT@
Environment=NEOSECRA_PROJECT=@PROJECT@
Environment=NEOSECRA_PRODUCT=@PRODUCT@
Environment=NEOSECRA_EDITION_ID=@EDITION@
ExecStart=@AGENT_SCRIPT@
StandardOutput=journal+console
StandardError=journal+console
# Never execute content from the trigger file beyond validated version string
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
# An empty bounding set breaks the agent's trigger-dir read/delete and the
# `cp -a` chown during release copies; keep exactly the caps the flow needs.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
