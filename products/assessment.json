{
  "code": "assessment",
  "aliases": [
    "neosecra-security-health"
  ],
  "channels": [
    "beta",
    "candidate",
    "stable"
  ],
  "archive_pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.(tar\\.gz|tgz|tar\\.xz|txz|tar\\.bz2|tbz2|tar\\.zst|tzst|tar)$",
  "trust_policy": "minisign-package-v1",
  "bundle": {
    "requirement": "none",
    "format": "none"
  },
  "images_lock": {
    "requirement": "required",
    "format": "name-ref-sha256-v1",
    "services": [
      "postgres",
      "redis",
      "backend",
      "worker",
      "beat",
      "frontend"
    ],
    "shared_services": [
      [
        "backend",
        "worker",
        "beat"
      ]
    ],
    "optional_services": [
      "openvas",
      "zap",
      "dast-egress"
    ],
    "archive_path": "deployment/release/images.lock"
  },
  "bootstrap": "bootstrap.sh",
  "gate": {
    "script": "ci/prerelease-gate.sh",
    "channels": [
      "stable"
    ],
    "inputs": [
      "archive",
      "version",
      "trust-policy",
      "registry"
    ]
  },
  "migration_metadata": "none",
  "rollback_policy": "backup-restore",
  "release_layout": "version",
  "steps": [
    "images-lock"
  ],
  "channel_defaults": {
    "edition": "standard",
    "status": "available"
  },
  "secret_allowlist": [],
  "legacy_editions": [
    "security-health"
  ],
  "legacy_empty_channels": [
    "beta"
  ],
  "pending_channels": [
    "candidate"
  ]
}
