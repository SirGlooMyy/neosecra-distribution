deployment/v1/.env.v1
deployment/v1/.env.v1.backup-*
.env.v1
.env.v1.backup-*

# Secret key material — never commit
*.key
*.key.*
*.srl
**/secrets/**
~/.neosecra/

# But DO track public certificates
!*.crt
!*.pub

# Generated release artifacts (created by publish.sh/build-release.sh)
update-server/www/releases/*/distribution.tar.gz
update-server/www/releases/*/distribution.tar.gz.sha256
update-server/www/releases/*/distribution.tar.gz.minisig
update-server/www/releases/*/docker-bundle-*
update-server/www/channels/*.minisig
# Oversized self-referential snapshot — publish to server, never commit
update-server/www/releases/1.3.13/distribution-1.3.13.tar.gz

.secrets-ca/
test-results/

# TwinCore orchestration local state — git'e girmez
.agent/state/
.agent/runs/

# Python test cache & bytecode
__pycache__/
*.pyc
.pytest_cache/

# Local scratch files and publication leftovers
/patch_*.py
/patch_*.sh
/verify_debug.py
/test_verify.sh
/diff.patch
/enforce.sh
/;
/COMMIT_PLAN.md
/update-server/enforce.sh
/update-server/.backup-*/
/update-server/www.tar.gz
/update-server/www/releases/.failed-*/
/update-server/www/releases/*/hotspot-*.tar.gz*
/update-server/www/releases/*/bootstrap*.sh*
/.codex-python/
/.codex-tmp/
